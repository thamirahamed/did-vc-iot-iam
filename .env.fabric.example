# Minimal Fabric path example.
# FABRIC_SAMPLES_ORGS_HOST_PATH points to fabric-samples/test-network/organizations.
# On Windows, use an absolute path with forward slashes for Docker Compose volume mounts.

# Recommended repo-local install:
FABRIC_SAMPLES_ORGS_HOST_PATH=C:/Users/<user>/Documents/CodingProjects/did-vc-iot-iam/third_party/fabric-samples/test-network/organizations

# External install example:
# FABRIC_SAMPLES_ORGS_HOST_PATH=C:/Users/<user>/Documents/CodingProjects/fabric-samples/test-network/organizations
