# Copy this file to .env.project and edit paths for your machine.
# .env.project is local and ignored by git.
# On Windows, use absolute paths with forward slashes for Docker bind paths.
# Avoid spaces in project and Fabric Samples paths.

PROJECT_ROOT=.

# Recommended: install Fabric Samples into this repository's ignored third_party folder.
# Replace <user> with your Windows user name, or use your own absolute project path.
FABRIC_SAMPLES_PATH=C:/Users/<user>/Documents/CodingProjects/did-vc-iot-iam/third_party/fabric-samples
FABRIC_SAMPLES_ORGS_HOST_PATH=C:/Users/<user>/Documents/CodingProjects/did-vc-iot-iam/third_party/fabric-samples/test-network/organizations

# External Fabric Samples installs still work. Use values like:
# FABRIC_SAMPLES_PATH=C:/Users/<user>/Documents/CodingProjects/fabric-samples
# FABRIC_SAMPLES_ORGS_HOST_PATH=C:/Users/<user>/Documents/CodingProjects/fabric-samples/test-network/organizations

FABRIC_SAMPLES_PATH_CONTAINER=/fabric-samples
FABRIC_TEST_NETWORK_PATH_CONTAINER=/fabric-samples/test-network

FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=iam
FABRIC_DOCKER_NETWORK=fabric_test
FABRIC_BATCH_TIMEOUT=2s
FABRIC_MAX_MESSAGE_COUNT=50
FABRIC_PREFERRED_MAX_BYTES=2 MB
FABRIC_ABSOLUTE_MAX_BYTES=10 MB

ISSUER_URL=http://issuer:8000
VERIFIER_URL=http://verifier:8001
DASHBOARD_VERIFIER_URL=http://verifier:8001
FABRIC_ADAPTER_URL=http://fabric-adapter:8010
DASHBOARD_API_URL=http://dashboard-api:8020
BENCHMARK_AGENT_GATEWAY_URL=http://benchmark-agent-gateway:8031
BENCHMARK_AGENT_CONSTRAINED_URL=http://benchmark-agent-constrained:8031
BENCHMARK_AGENT_LOW_URL=http://benchmark-agent-low:8031
BENCHMARK_AGENT_TINY_URL=http://benchmark-agent-tiny:8031
TOXIPROXY_URL=http://toxiproxy:8474
TOXIPROXY_ISSUER_URL=http://toxiproxy:18000
TOXIPROXY_VERIFIER_URL=http://toxiproxy:18001
TOXIPROXY_FABRIC_ADAPTER_URL=http://toxiproxy:18010

DASHBOARD_DB_PATH=/data/dashboard/dashboard.db
DASHBOARD_DATA_DIR=/data/dashboard

REVOCATION_MODE=accumulator
AUDIT_MODE=async
FABRIC_CLIENT_MODE=adapter
VERIFIER_CACHE_WAIT_SECONDS=2.2
